{
  "name": "senior-cloud",
  "version": "0.1.0",
  "description": "Cloud platform with simple UI and only core functionality",
  "main": "src/server.ts",
  "scripts": {
    "start": "node ./dist/server.js",
    "server": "nodemon src/server.ts",
    "client": "npm start --prefix ./client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "tsc && npm run build --prefix ./client",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "cloud",
    "simple",
    "bnsoft",
    "upload",
    "download"
  ],
  "author": "BN Soft Ltd.",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.0.1",
    "express": "^4.18.1",
    "mongoose": "^6.5.2",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.13",
    "@types/passport": "^1.0.10",
    "@types/passport-jwt": "^3.0.6",
    "concurrently": "^7.3.0",
    "nodemon": "^2.0.19",
    "prettier": "^2.7.1",
    "ts-node": "^10.9.1",
    "typescript": "^4.7.4"
  }
}
